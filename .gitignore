.DS_Store
.zig-cache/
zig-out/
primitives/profiles/selection.json

# machine state — tool caches, runtime ledgers, deps. Never source.
.coraline/
.verify/
.pi/
node_modules/
/.done-cursor-purge

# Raw Tower board dumps — local-only evidence. They carry a localhost proxy
# credential that credential-guard (correctly) blocks, and redacting them would
# break the sha256 pins in briefs/tower/bus-data/INVENTORY.json. They stay on
# disk, verifiable by those hashes; they do not enter the repo.
briefs/tower/bus-data/backups/
briefs/tower/w0-swap-evidence/board.jsonl.pre-recovery-*
# Same ruling, already recorded in the tree by an earlier pass — see
# rotate-proofs/*/TOWER-COPY-OMITTED.md. PROOF.md carries the shas.
briefs/tower/w4-retention-evidence/rotate-proofs/*/tower-copy/
# Same ruling, tower-bus-integrity unit: raw board backups and repair tails are
# local-only evidence carrying the same credential. On disk, never in git.
briefs/tower-bus-integrity/backups/
briefs/tower-bus-integrity/repair/*.raw
