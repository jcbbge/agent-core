            'Use relay_inbox after verbatim display, or pass only ids from inboxState.unrelayed.'
        )
      }
      append(LEDGER, { id: id(), ts: now, cwd: CWD, kind: 'ack', ids })
      return `Acknowledged ${ids.length} message(s). Guard cleared for: ${ids.join(', ')}.`
