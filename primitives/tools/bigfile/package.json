{
  "name": "@agent-core/bigfile-mcp",
  "version": "0.1.0",
  "description": "MCP server: persistent JS scratchpad with a `bigfile` module for navigating huge source files via tree-sitter.",
  "private": true,
  "type": "module",
  "bin": {
    "bigfile-mcp": "src/server.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run --watch src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ax-llm/ax": "*",
    "tree-sitter": "^0.21.1",
    "tree-sitter-php": "^0.22.8",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "trustedDependencies": [
    "@ax-llm/ax",
    "tree-sitter-javascript",
    "tree-sitter-php"
  ]
}
